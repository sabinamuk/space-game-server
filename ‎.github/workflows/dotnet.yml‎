name: .NET CI

on:
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest

    permissions:
      contents: read
      pull-requests: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 9.0.x

      # 🔍 диагностика структуры (очень помогает при ошибках)
      - name: Show repo structure
        run: ls -R

      - name: Restore
        run: dotnet restore ./SpaceBattle.sln

      - name: Build
        run: dotnet build ./SpaceBattle.sln --no-restore --configuration Release

      - name: Test
        run: dotnet test ./SpaceBattle.sln --no-build --configuration Release --logger "trx"